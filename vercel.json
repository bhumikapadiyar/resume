{
  "version": 2,
  "builds": [
    {
      "src": "Resume-ATS-main/backEnd/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "Resume-ATS-main/frontEnd/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Resume-ATS-main/backEnd/index.js"
    },
    {
      "src": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|svg|json|map|woff|woff2|ttf|eot))",
      "dest": "/Resume-ATS-main/frontEnd/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Resume-ATS-main/frontEnd/public/index.html"
    }
  ]
}
